prefix=/data/yuqingchi/Code/AgenticVLA/third_party/imagemagick_env
libdir=${prefix}/lib
includedir=${prefix}/include

Name: atspi
Description: Accessibility Technology software library
Version: 2.40.3
Requires: dbus-1 >=  1.5, glib-2.0 >=  2.62.0
Requires.private: gobject-2.0 >=  2.0.0, x11, xtst, xi
Libs: -L${libdir} -latspi
Cflags: -I${includedir}/at-spi-2.0
