prefix=/data/yuqingchi/Code/AgenticVLA/third_party/imagemagick_env
includedir=${prefix}/include
libdir=${prefix}/lib

epoxy_has_glx=1
epoxy_has_egl=1
epoxy_has_wgl=0

Name: epoxy
Description: GL dispatch library
Version: 1.5.10
Requires.private: egl, gl egl
Libs: -L${libdir} -lepoxy
Libs.private: -ldl
Cflags: -I${includedir}
