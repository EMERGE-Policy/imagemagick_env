prefix=/data/yuqingchi/Code/AgenticVLA/third_party/imagemagick_env
includedir=${prefix}/include
libdir=${prefix}/lib

sysconfdir=/data/yuqingchi/Code/AgenticVLA/third_party/imagemagick_env/etc
localstatedir=/data/yuqingchi/Code/AgenticVLA/third_party/imagemagick_env/var
confdir=/data/yuqingchi/Code/AgenticVLA/third_party/imagemagick_env/etc/fonts
cachedir=/data/yuqingchi/Code/AgenticVLA/third_party/imagemagick_env/var/cache/fontconfig

Name: Fontconfig
Description: Font configuration and customization library
Version: 2.18.2
Requires.private: freetype2 >=  21.0.15, expat
Libs: -L${libdir} -lfontconfig
Libs.private: -pthread -lm
Cflags: -I${includedir}
